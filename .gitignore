# Build / tooling junk
__pycache__/
.venv/
.pytest_cache/
*.log
*.aux
*.out
*.db-shm
*.db-wal

# Scratch / temp assets
/_diag_shade.png

# Strict diagram asset policy: figures are .tex + 300 DPI .png ONLY
# (no .svg, .jpg, .jpeg, or retained .pdf diagram assets, except harvested question crops in BECE_MOCK_PAPERS)
*.svg
*.jpg
*.jpeg
!/BECE_MOCK_PAPERS/data/extracted_questions/images/*.jpg
!/BECE_MOCK_PAPERS/data/extracted_questions/images/*.jpeg

# Lock files
.mimocode/.cron-lock
