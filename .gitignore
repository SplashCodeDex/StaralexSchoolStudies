# BECE Mock Papers is its own repository with history — keep it nested, never embed it
/BECE_MOCK_PAPERS/

# Build / tooling junk
__pycache__/
.venv/
.pytest_cache/
*.log
*.aux
*.out

# Scratch / temp assets
/_diag_shade.png

# Strict diagram asset policy: figures are .tex + 300 DPI .png ONLY
# (no .svg, .jpg, .jpeg, or retained .pdf diagram assets)
*.svg
*.jpg
*.jpeg

# Lock files
.mimocode/.cron-lock
