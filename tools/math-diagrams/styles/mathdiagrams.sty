% mathdiagrams.sty — shared TikZ styles for Staralex maths lesson figures
% Compile with: pdflatex + standalone (see tools/math-diagrams/build.py)
% Visual contract: light-friendly textbook figures, Segoe UI labels,
% one accent blue, ink black, no gradients/glows.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathdiagrams}[2026/10/20 v1.0 Staralex maths diagram styles]

\RequirePackage{tikz}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\usetikzlibrary{
  arrows.meta,
  calc,
  angles,
  quotes,
  patterns,
  decorations.pathreplacing,
  positioning,
  shapes.geometric
}

% ---------------------------------------------------------------------------
% Palette (keep in sync with tools/build_lesson_pdf.py)
% ---------------------------------------------------------------------------
\definecolor{mdInk}{HTML}{1A1A1A}
\definecolor{mdAccent}{HTML}{1F4E79}
\definecolor{mdAccentSoft}{HTML}{D6E3F0}
\definecolor{mdRed}{HTML}{B33A3A}
\definecolor{mdGreen}{HTML}{2E7D4F}
\definecolor{mdAmber}{HTML}{B8860B}
\definecolor{mdMuted}{HTML}{555555}
\definecolor{mdGrid}{HTML}{C5CDD8}
\definecolor{mdFill}{HTML}{F4F7FB}
\definecolor{mdWhite}{HTML}{FFFFFF}

% ---------------------------------------------------------------------------
% Base canvas
% ---------------------------------------------------------------------------
\tikzset{
  md/.style = {
    line width=0.8pt,
    color=mdInk,
    font=\sffamily\small,
    inner sep=1.5pt,
    >=Stealth
  },
  md axis/.style = {md, color=mdInk, ->},
  md grid/.style = {md, color=mdGrid, line width=0.4pt},
  md shape/.style = {md, draw=mdInk, fill=mdWhite},
  md shape fill/.style = {md, draw=mdInk, fill=mdFill},
  md accent/.style = {md, draw=mdAccent, line width=1.2pt},
  md accent fill/.style = {md, draw=mdAccent, fill=mdAccentSoft},
  md highlight/.style = {md, draw=mdRed, line width=1.2pt},
  md label/.style = {md, color=mdInk, font=\sffamily\normalsize, fill=white, fill opacity=0.9, text opacity=1, inner sep=2pt, rounded corners=1pt},
  md label bold/.style = {md, color=mdInk, font=\sffamily\normalsize\bfseries, fill=white, fill opacity=0.9, text opacity=1, inner sep=2pt, rounded corners=1pt},
  md label muted/.style = {md, color=mdMuted, font=\sffamily\small, fill=white, fill opacity=0.9, text opacity=1, inner sep=2pt, rounded corners=1pt},
  md label accent/.style = {md, color=mdAccent, font=\sffamily\normalsize\bfseries, fill=white, fill opacity=0.9, text opacity=1, inner sep=2pt, rounded corners=1pt},
  md label naked/.style = {md, color=mdInk, font=\sffamily\normalsize},
  md label big/.style = {md, color=mdInk, font=\sffamily\large\bfseries, fill=white, fill opacity=0.9, text opacity=1, inner sep=2pt, rounded corners=1pt},
  md tick/.style = {md, color=mdInk, line width=0.7pt},
  md dashed/.style = {md, dashed},
  md thin/.style = {md, line width=0.45pt},
  md thick/.style = {md, line width=1.4pt},
  md arrow/.style = {md, ->, >={Stealth}},
  md arrow both/.style = {md, <->, >={Stealth}},
  md ray/.style = {md, ->, >={Stealth[length=3pt]}},
  md point/.style = {circle, fill=mdInk, draw=mdInk, inner sep=0pt, minimum size=3.2pt},
  md open point/.style = {circle, draw=mdInk, fill=mdWhite, line width=0.9pt, inner sep=0pt, minimum size=3.4pt},
  md accent point/.style = {circle, fill=mdAccent, draw=mdAccent, inner sep=0pt, minimum size=3.4pt},
  md right angle/.style = {md, draw=mdInk, line width=0.55pt},
  md angle arc/.style = {md, draw=mdAccent, line width=0.9pt},
  md brace/.style = {md, color=mdMuted, decorate, decoration={brace, amplitude=4pt, raise=1pt}},
  md brace label/.style = {md, color=mdMuted, font=\sffamily\footnotesize},
  md box/.style = {md, draw=mdInk, fill=mdFill, rounded corners=2pt},
  md venn A/.style = {md, draw=mdAccent, fill=mdAccentSoft, fill opacity=0.55, draw opacity=1},
  md venn B/.style = {md, draw=mdRed, fill=mdRed, fill opacity=0.18, draw opacity=1},
  md venn C/.style = {md, draw=mdGreen, fill=mdGreen, fill opacity=0.18, draw opacity=1},
  md venn U/.style = {md thin, draw=mdInk},
}

% ---------------------------------------------------------------------------
% Number line helpers
% ---------------------------------------------------------------------------
% \mdNumberLine[opts]{lo}{hi}{body}
% body draws on the line; coordinates use axis units via \mdNLx
\newcommand{\mdNLunit}{1} % cm per integer unit (override per figure)

\newcommand{\mdOpenDot}[3]{% x y label
  \node[md open point] at (#1,#2) {};
  \if\relax\detokenize{#3}\relax\else
    \node[md label] at (#1,#2+0.38) {#3};
  \fi
}
\newcommand{\mdClosedDot}[3]{% x y label
  \node[md point] at (#1,#2) {};
  \if\relax\detokenize{#3}\relax\else
    \node[md label] at (#1,#2+0.38) {#3};
  \fi
}

\newcommand{\mdAngleArc}[5]{% {center}{start pt}{end pt}{radius cm}{label}
  \draw[md angle arc] (#2) arc[start angle=#3, end angle=#4, radius=#5];
  \node[md label accent] at ($(#2)!0.5!(#3)$) {#5};
}

% Right-angle square at vertex B of A--B--C, size in cm
\newcommand{\mdRightAngle}[4]{% {A}{B}{C}{size}
  \path (#1) -- (#2) -- (#3)
    pic {right angle=#1--#2--#3};
}

% Arc angle mark at vertex B of A--B--C
\newcommand{\mdMarkAngle}[5]{% {A}{B}{C}{radius}{label}
  \pic[#5, draw=mdAccent, line width=0.9pt, angle radius=#4, angle eccentricity=1.25] {angle=#1--#2--#3};
}

% Dimension / length label along a segment
\newcommand{\mdDim}[4]{% {p1}{p2}{offset cm}{text}
  \draw[md thin, <->] ($(#1)+(#3)$) -- ($(#2)+(#3)$);
  \node[md label] at ($(#1)!0.5!(#2)+(#3)$) {#4};
}

% Coordinate axes box: origin at (0,0), grid optional
\newcommand{\mdAxes}[6]{% xmin xmax ymin ymax xstep ystep
  \draw[md grid] (#1,#3) grid (#2,#4);
  \draw[md axis] (#1,0) -- (#2,0) node[md label, below right=1pt and 2pt] {$x$};
  \draw[md axis] (0,#3) -- (0,#4) node[md label, above left=1pt and 2pt] {$y$};
  \foreach \x in {#1,#5,...,#2} {
    \ifdim\x pt=0pt\else
      \draw[md tick] (\x,0.08) -- (\x,-0.08) node[md label] at (\x,-0.28) {$\x$};
    \fi
  }
  \foreach \y in {#3,#6,...,#4} {
    \ifdim\y pt=0pt\else
      \draw[md tick] (0.08,\y) -- (-0.08,\y) node[md label] at (-0.28,\y) {$\y$};
    \fi
  }
  \node[circle, fill=mdInk, inner sep=0pt, minimum size=2.4pt] at (0,0) {};
  \node[md label] at (-0.28,-0.28) {$O$};
}

\endinput
